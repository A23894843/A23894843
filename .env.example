# Existing Supabase server configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY

# Cloudflare Turnstile server secret
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET

# Query reply email delivery — your existing Gmail SMTP setup
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-portfolio@gmail.com
SMTP_PASS=YOUR_GOOGLE_APP_PASSWORD
EMAIL_FROM=Abhinandan <your-portfolio@gmail.com>
