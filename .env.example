# Server-side Vercel/Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Optional: enables GitHub GraphQL contribution stats.
# If omitted, api/github.js falls back to the public contribution API.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Browser Supabase values are intentionally NOT read from process.env.
# Keep SUPABASE_URL and SUPABASE_ANON_KEY in /admin/config.js as already configured.
